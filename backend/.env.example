# =========================================================
# RapidDoc Backend Configuration
# Copy this file to .env and adjust values as needed:
#   Windows:  copy .env.example .env
# The .env file is NOT committed to git.
# =========================================================

# FastAPI Settings
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="RapidDoc API"

# MongoDB Connection
# Local MongoDB (default). For MongoDB Atlas use:
#   MONGODB_URL=mongodb+srv://<user>:<pass>@<cluster>/rapiddoc
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=rapiddoc

# JWT Secret Key Configuration
# GENERATE YOUR OWN: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT reuse the placeholder value below in production.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=storage

# Google Gemini API Settings (used by AI features; fallback when a local model fails)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# --- Password reset OTP / email delivery -------------------------------
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=45
# Show the OTP in the UI when no mailer is configured (local/demo use).
OTP_DEV_MODE=true

# Fill these in to email real OTPs. Gmail needs an App Password:
# https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=your16charapppassword
#   SMTP_FROM=youraddress@gmail.com
#   SMTP_USE_TLS=true
#   OTP_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15

# Local fine-tuned brain models (only used when AI_USE_LOCAL_MODELS=true).
# Leave these commented out to use the built-in defaults, which point at
# backend/models/<name> and work regardless of the working directory.
AI_USE_LOCAL_MODELS=true
# INTENT_MODEL_PATH=models/rapiddoc_intent_model
# TEXT_REWRITER_MODEL_PATH=models/rapiddoc_text_rewriter
# MCQ_GENERATOR_MODEL_PATH=models/rapiddoc_mcq_generator
# SUMMARIZER_MODEL_PATH=models/rapiddoc_summarizer

# Confidence below this falls back to Gemini, then the regex engine.
# Keep this low: confident intents on the fine-tuned checkpoint measure ~0.28-0.78,
# and any intent without extractable slots is rejected anyway.
INTENT_CONFIDENCE_THRESHOLD=0.15
# Separate, softer bar for the zero-shot MNLI checkpoint (if that is what is installed).
INTENT_CONFIDENCE_THRESHOLD_ZERO_SHOT=0.15

# T5 text rewriter (CoEdIT expects "<instruction>: <text>")
# T5_NUM_BEAMS=2
# T5_MAX_GEN_LENGTH=256
# T5_NO_REPEAT_NGRAM_SIZE=3
# TEXT_REWRITER_TEMPLATE={instruction}: {text}

# BART summarizer
# SUMMARIZER_MAX_INPUT_CHARS=12000
# SUMMARIZER_MAX_INPUT_TOKENS=1024
# SUMMARIZER_MAX_GEN_TOKENS=128
# SUMMARIZER_NUM_BEAMS=4
# SUMMARIZER_LENGTH_PENALTY=2.0
# SUMMARIZER_NO_REPEAT_NGRAM_SIZE=3
# Map phase speed controls: only this many chunks use the neural model (the
# rest are instant extractive), with a hard wall-clock budget on the phase.
# SUMMARIZER_MAX_NEURAL_CHUNKS=4
# SUMMARIZER_MAP_TIME_BUDGET_SECONDS=45
# SUMMARIZER_CHUNK_NUM_BEAMS=1
# SUMMARIZER_CHUNK_MAX_NEW_TOKENS=96

# BART MCQ generator
# MCQ_MAX_QUESTIONS=10          # hard cap on questions per request
# MCQ_MIN_PASSAGE_CHARS=120     # refuse to build a question from a stub
# MCQ_PASSAGE_CHARS=1200        # document characters fed per question
# MCQ_NUM_CANDIDATES=4          # beams sampled per call; picks the best valid one
# MCQ_MAX_INPUT_TOKENS=512
# MCQ_MAX_GEN_TOKENS=128
# MCQ_NUM_BEAMS=4
# MCQ_NO_REPEAT_NGRAM_SIZE=3
