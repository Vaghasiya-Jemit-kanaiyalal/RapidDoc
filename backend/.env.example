# FastAPI Settings
PORT=General
HOST=
PROJECT_NAME="RapidDoc API"

# MongoDB Connection
# Set local or remote MongoDB URL
MONGODB_URL=MongoDB_URL
# The database name used for this app (created permanently on first connect)
MONGODB_DB_NAME=rapiddoc

# JWT Secret Key

JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Configuration

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=storage
