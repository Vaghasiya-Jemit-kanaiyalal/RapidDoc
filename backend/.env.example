# =========================================================
# RapidDoc Backend Configuration
# Copy this file to .env and adjust values as needed:
#   Windows:  copy .env.example .env
# The .env file is NOT committed to git.
# =========================================================

# FastAPI Settings
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="RapidDoc API"

# MongoDB Connection
# Local MongoDB (default). For MongoDB Atlas use:
#   MONGODB_URL=mongodb+srv://<user>:<pass>@<cluster>/rapiddoc
MONGODB_URL=mongodb://localhost:27017/rapiddoc
# The database name used for this app (created permanently on first connect)
MONGODB_DB_NAME=rapiddoc

# JWT Secret Key
# GENERATE YOUR OWN:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT reuse the example value below in production.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=storage
